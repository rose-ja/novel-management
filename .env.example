# 本地开发占位配置：不要提交真实口令。
# Docker Compose 默认读取本文件；复制为 .env 后按需修改。
# 未列出的变量由 internal/config 提供默认值（见 PROJECT-SETUP.md 与 deployment.md §2.1）。

APP_VERSION=dev
APP_PORT=17860
APP_HOST=0.0.0.0
# 留空时由 APP_PORT 派生 127.0.0.1:<port>,localhost:<port>
ALLOWED_HOSTS=
DATA_DIR=/data
POSTGRES_PASSWORD=nm_local_only
# 修改口令时同步修改此连接串（Compose 下容器内主机为 db）
DATABASE_URL=postgres://novel:nm_local_only@db:5432/novel?sslmode=disable
REDIS_ADDR=cache:6379
REDIS_PASSWORD=
CACHE_TTL_SEC=60
MAX_UPLOAD_MB=6144
SNAPSHOT_KEEP=3
IMPORT_TTL_MIN=120
IMPORT_TIMEOUT_MIN=120
LOG_LEVEL=INFO
TZ=Asia/Shanghai
